<configuration>
    <!-- Metastore settings -->
    <property>
        <name>metastore.thrift.uris</name>
        <value>thrift://hive-metastore:9083</value>
        <description>Thrift URI for the remote metastore. Used by metastore client to connect to remote metastore.</description>
    </property>
    <property>
        <name>metastore.task.threads.always</name>
        <value>org.apache.hadoop.hive.metastore.events.EventCleanerTask,org.apache.hadoop.hive.metastore.MaterializationsCacheCleanerTask</value>
    </property>
    <property>
        <name>metastore.expression.proxy</name>
        <value>org.apache.hadoop.hive.metastore.DefaultPartitionExpressionProxy</value>
    </property>

    <!-- Database connection settings - CRITICAL FIXES -->
    <property>
        <name>javax.jdo.option.ConnectionDriverName</name>
        <value>org.mariadb.jdbc.Driver</value>
        <description>Use MariaDB driver instead of MySQL</description>
    </property>
    <property>
        <name>javax.jdo.option.ConnectionURL</name>
        <value>jdbc:mariadb://mariadb:3306/metastore_db?useUnicode=true&amp;characterEncoding=UTF-8&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;connectTimeout=30000&amp;socketTimeout=60000</value>
        <description>MariaDB connection URL with timeout parameters</description>
    </property>
    <property>
        <name>javax.jdo.option.ConnectionUserName</name>
        <value>admin</value>
    </property>
    <property>
        <name>javax.jdo.option.ConnectionPassword</name>
        <value>admin</value>
    </property>

    <property>
        <name>hive.aux.jars.path</name>
        <value>/opt/hive/lib/mariadb-java-client-3.5.6.jar</value>
        <description>Additional JARs for Hive</description>
    </property>

    <!-- Connection pool optimization -->
    <property>
        <name>javax.jdo.option.ConnectionPoolSize</name>
        <value>5</value>
        <description>Reduced pool size to prevent connection overload</description>
    </property>
    <property>
        <name>javax.jdo.option.ConnectionTimeout</name>
        <value>60000</value>
        <description>Connection timeout in milliseconds</description>
    </property>
    <property>
        <name>javax.jdo.option.IdleTimeout</name>
        <value>300000</value>
        <description>Idle connection timeout</description>
    </property>
    <property>
        <name>datanucleus.connectionPoolingType</name>
        <value>HikariCP</value>
        <description>Use HikariCP for better connection management</description>
    </property>

    <!-- Hive metastore specific timeouts -->
    <property>
        <name>hive.metastore.client.socket.timeout</name>
        <value>300</value>
        <description>Socket timeout for metastore client</description>
    </property>
    <property>
        <name>hive.metastore.try.direct.sql</name>
        <value>true</value>
        <description>Use direct SQL for better performance</description>
    </property>
    <property>
        <name>hive.metastore.failure.retries</name>
        <value>3</value>
        <description>Number of retries for failed operations</description>
    </property>

    <!-- MinIO/S3 configuration -->
    <property>
        <name>fs.s3a.access.key</name>
        <value>minio</value>
    </property>
    <property>
        <name>fs.s3a.secret.key</name>
        <value>mpassword</value>
    </property>
    <property>
        <name>fs.s3a.endpoint</name>
        <value>http://minio:9000</value>
    </property>
    <property>
        <name>fs.s3a.path.style.access</name>
        <value>true</value>
    </property>
    <property>
        <name>fs.s3a.connection.timeout</name>
        <value>60000</value>
        <description>S3 connection timeout</description>
    </property>

    <!-- Additional performance tuning -->
    <property>
        <name>hive.metastore.cache.pinobjtypes</name>
        <value>Table,StorageDescriptor,SerDeInfo,Partition,Database,Type,FieldSchema,Order</value>
        <description>Object types to cache in metastore</description>
    </property>

    <property>
        <name>hive.metastore.warehouse.dir</name>
        <value>s3a://hive/warehouse</value>
        <description>Warehouse directory in MinIO</description>
    </property>
    
</configuration>


