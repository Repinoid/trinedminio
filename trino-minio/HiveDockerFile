# Команда для сборки:
# docker buildx build -f HiveDockerFile -t hivewnetcat:latest .


FROM apache/hive:4.0.0-beta-1

USER root

# Установка Hadoop
RUN apt-get update && \
    apt-get install -y wget && \
    wget https://archive.apache.org/dist/hadoop/common/hadoop-3.2.0/hadoop-3.2.0.tar.gz && \
    tar -xzf hadoop-3.2.0.tar.gz -C /opt/ && \
    ln -s /opt/hadoop-3.2.0 /opt/hadoop && \
    rm hadoop-3.2.0.tar.gz

RUN apt-get update && apt-get install -y \
    curl \
    netcat-openbsd \
    net-tools \
    iproute2 \
    telnet \
    procps \
    && rm -rf /var/lib/apt/lists/*

USER hive